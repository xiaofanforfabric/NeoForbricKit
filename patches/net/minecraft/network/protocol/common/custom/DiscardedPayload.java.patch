+            // An empty array writes nothing, which is byte-for-byte what vanilla sent.
+            (payload, buf) -> buf.writeBytes(payload.data),
+            buf -> {
+                int length = buf.readableBytes();
+                if (length >= 0 && length <= maxPayloadSize) {
+                    // Read rather than skip: the bytes ARE the message a plugin is waiting for.
+                    // The limit above is still checked first, so nothing unbounded is allocated.
+                    byte[] data = new byte[length];
